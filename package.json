{
  "name": "playwright-ts",
  "version": "1.0.0",
  "description": "Proyecto de automatización E2E con Playwright y TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx playground/clase1/taller1.ts",
    "taller2": "tsx playground/clase2/index.ts",
    "tarea1": "npx playwright test tests/tarea1",
    "taller3": "npx playwright test tests/taller3/ suiteAndActions.spec.ts --headed",
    "taller4": "npx playwright test tests/taller3/ suiteAndActions.spec.ts --headed",
    "tarea2": "npx playwright test tests/tarea2/",
    "taller5": "npx playwright test tests/taller5/refactDialogAndUpload.spec.ts",
    "taller5:auth": "npx playwright test tests/taller5/authentication.spec.ts",
    "taller6": "npx playwright test tests/taller6/02-data driven.login.spec.ts --headed",
    "tarea3": "npx playwright test tests/tarea3/exerciseContact.spec.ts --headed",
    "taller7IphoneDuo": "npx playwright test tests/example.spec.ts --headed --project='Iphone Duo 2026'",
    "integrador:suite1": "npx playwright test tests/integrador/suite1-registro.spec.ts --project=chromium --headed",
    "integrador:suite2": "npx playwright test tests/integrador/suite2-auth.spec.ts --project=chromium --headed",
    "integrador:suite3": "npx playwright test tests/integrador/suite3-compra.spec.ts --project=chromium --headed",
    "integrador": "npx playwright test tests/integrator/suite1-auth.spec.ts --project=chromium --headed && npx playwright test tests/integrator/suite2-compra.spec.ts --project=chromium --headed && node helpers/generate-pdf.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Jose V.",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.7"
  }
}
