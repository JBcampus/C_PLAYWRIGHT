{
  "name": "playwright-ts",
  "version": "1.0.0",
  "description": "Proyecto de automatizacion E2E con Playwright y TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx playground/clase1/taller1.ts",
    "taller2": "tsx playground/clase2/index.ts",
    "tarea1": "tsx playground/tarea1/index.ts",
    "tarea2": "playwright test tests/tarea2",
    "tarea3": "playwright test tests/tarea3",
    "typecheck": "tsc -- noEmit",
    "open-ui": "npx playwright test --ui",
    "taller5": "npx playwright test tests/taller5/refactDialogAndUpload.spec.ts",
    "taller5:auth": "npx playwright test tests/taller5/authentication.spec.ts",
    "taller6": "npx playwright test tests/taller6/01-state-cookies-data-driven.spec.ts",
    "run:iphoneDuo": "npx playwright test tests/example.spec.ts --headed --project='Iphone Duo 2026'"

  },
  "keywords": [],
  "author": "Jose Carlos",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
